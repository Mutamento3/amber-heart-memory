# Explicit configuration only. These files are never loaded automatically.
# Set complete connection strings with host, dbname and user; use separate roles.
MEMORY_INSTALL_DSN=
MEMORY_DSN=
MEMORY_CONFIG_DSN=
# Dimensions, IANA timezone and business-day hour are install CLI options;
# runtime reads the installed settings from Postgres, avoiding duplicate defaults.
# Recall defaults are defined only in recall/recall_config.py, not overridden here.
# Inspect names and values: python3 -m memory_core.recall.recall --show-defaults
# Optional overrides use the printed MEMORY_* environment names.
# Optional recall roles: explicit model, optional paired endpoint/key.
MEMORY_UPSTREAM_BASE_URL=
MEMORY_UPSTREAM_API_KEY=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_KEYWORD_MODEL=
MEMORY_KEYWORD_BASE_URL=
MEMORY_KEYWORD_API_KEY=
# Document rerank uses its own endpoint, key and model. Format: voyage or cohere.
MEMORY_DOCUMENT_RERANK_FORMAT=voyage
MEMORY_DOCUMENT_RERANK_MODEL=
MEMORY_DOCUMENT_RERANK_BASE_URL=
MEMORY_DOCUMENT_RERANK_API_KEY=
# SiliconFlow example (replace the four settings above):
# MEMORY_DOCUMENT_RERANK_FORMAT=cohere
# MEMORY_DOCUMENT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# MEMORY_DOCUMENT_RERANK_BASE_URL=https://api.siliconflow.cn/v1
# MEMORY_DOCUMENT_RERANK_API_KEY=<SILICONFLOW_API_KEY>
MEMORY_FINAL_RERANK_MODEL=
MEMORY_FINAL_RERANK_BASE_URL=
MEMORY_FINAL_RERANK_API_KEY=
# Optional per-call timeout; web also applies its whole-recall deadline.
# MEMORY_RECALL_MODEL_TIMEOUT_SECONDS=5

# 完整草稿进入待审后，至少等待这些小时，再由每日任务收录。
MEMORY_AUTO_APPROVE_AFTER_HOURS=48

# 在场卡片距最后报告使用/入库/恢复的归档期限（实际经过天数）。
MEMORY_ARCHIVE_RULE_DAYS=365
MEMORY_ARCHIVE_REFLECTION_DAYS=180
MEMORY_ARCHIVE_KNOWLEDGE_DAYS=180
MEMORY_ARCHIVE_EVENT_DAYS=120
MEMORY_ARCHIVE_EMOTIONAL_DAYS=365
# 回执保护：只统计注入过记忆的已结束轮次，使用和未使用都算回执。
MEMORY_ARCHIVE_RECEIPT_WINDOW_DAYS=14
MEMORY_ARCHIVE_RECEIPT_MIN_SAMPLES=20
MEMORY_ARCHIVE_RECEIPT_MIN_RATE=0.8

# Monthly topic summaries: an explicit model is required; omitted means skipped.
MEMORY_TOPIC_SUMMARY_MODEL=
MEMORY_TOPIC_SUMMARY_BASE_URL=
MEMORY_TOPIC_SUMMARY_API_KEY=
# Complete-month windows, including the final month in full.
MEMORY_TOPIC_SUMMARY_MIN_CARDS=5
MEMORY_TOPIC_SUMMARY_MAX_CARDS=30
