# Explicitly export these values; no project .env is automatically loaded.
MEMORY_DSN=
MEMORY_CONFIG_DSN=
MEMORY_INSTALL_DSN=
MEMORY_WEB_ORIGIN=https://memory.example.org
MEMORY_WEB_PASSWORD_FILE=/var/lib/memory-admin/password.hash
# Only for loopback development; never allow public HTTP.
MEMORY_WEB_LOCAL_HTTP=0
# Optional, explicit synthetic acceptance only. Normal mode leaves this unset.
MEMORY_WEB_FIXED_MODELS_FILE=
# Server-only. Generate once: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this master key with your private backup, outside the database.
MEMORY_ACCESS_KEY_MASTER_KEY=
# Optional hosted chat proxy; include /v1 (or the provider's equivalent).
MEMORY_UPSTREAM_BASE_URL=
MEMORY_UPSTREAM_API_KEY=
# Default is 300 seconds. Tool waits retain the space; active requests renew it.
MEMORY_PROXY_TURN_TIMEOUT_SECONDS=300
# One deadline covers keyword cleaning, search, both rerank stages and snapshot.
MEMORY_PROXY_RECALL_TIMEOUT_SECONDS=8
# At the start of a business day, carry complete rounds covering this many
# previous-day body messages. Replayed until the first summary of the day.
MEMORY_PROXY_PREVIOUS_DAY_MESSAGES=4

# Summary model must be explicit; the endpoint/key inherit main upstream by default.
# Optional dedicated endpoint/key must be configured together.
MEMORY_SUMMARY_MODEL=
MEMORY_SUMMARY_BACKUP_MODEL=
MEMORY_SUMMARY_BASE_URL=
MEMORY_SUMMARY_API_KEY=
# Absolute timeout per model attempt, including thinking and the full response.
MEMORY_SUMMARY_TIMEOUT_SECONDS=120
# One whole round always counts as two messages, regardless of tool steps.
MEMORY_SUMMARY_TRIGGER_MESSAGES=28
MEMORY_SUMMARY_RETAIN_TURNS=2
MEMORY_SUMMARY_ROLLUP_TRIGGER=8
# Unicode characters of raw history, not tokens or an entire-model context limit.
# An unusually long-history fallback; normal chats use the message-count trigger.
MEMORY_SUMMARY_MAX_HISTORY_CHARS=30000

# Daily diaries share the main upstream by default; model names are explicit.
MEMORY_DIARY_MODEL=
MEMORY_DIARY_BACKUP_MODEL=
MEMORY_DIARY_BASE_URL=
MEMORY_DIARY_API_KEY=
MEMORY_DIARY_TIMEOUT_SECONDS=300
# Last available diaries, rather than calendar days; 0 disables injection.
MEMORY_DIARY_RECENT_COUNT=3
# Bound catch-up work; raw retention may make fewer days available.
MEMORY_DIARY_BACKFILL_DAYS=30
# HH:MM in the installed timezone, strictly after the business-day boundary.
# Empty means 15 minutes after that configured boundary.
MEMORY_DAILY_RUN_TIME=

# Optional recall model roles. Model names are explicit; no implicit models.
# A dedicated endpoint/key must be paired. Omit both to inherit main upstream.
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_KEYWORD_MODEL=
MEMORY_KEYWORD_BASE_URL=
MEMORY_KEYWORD_API_KEY=
MEMORY_FINAL_RERANK_MODEL=
MEMORY_FINAL_RERANK_BASE_URL=
MEMORY_FINAL_RERANK_API_KEY=
# Document rerank uses its own endpoint, key and model. Format: voyage or cohere.
MEMORY_DOCUMENT_RERANK_FORMAT=voyage
MEMORY_DOCUMENT_RERANK_MODEL=
MEMORY_DOCUMENT_RERANK_BASE_URL=
MEMORY_DOCUMENT_RERANK_API_KEY=
# SiliconFlow example (replace the four settings above):
# MEMORY_DOCUMENT_RERANK_FORMAT=cohere
# MEMORY_DOCUMENT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# MEMORY_DOCUMENT_RERANK_BASE_URL=https://api.siliconflow.cn/v1
# MEMORY_DOCUMENT_RERANK_API_KEY=<SILICONFLOW_API_KEY>
# Absolute per-call cap, further bounded by the remaining recall deadline.
MEMORY_RECALL_MODEL_TIMEOUT_SECONDS=5

# Daily two-step extraction. No implicit model; empty skips the job.
MEMORY_EXTRACTION_MODEL=
MEMORY_EXTRACTION_BASE_URL=
MEMORY_EXTRACTION_API_KEY=
# Applies separately to selection and structure, including each format retry.
MEMORY_EXTRACTION_TIMEOUT_SECONDS=600
MEMORY_IMPORT_CONCURRENCY=3
MEMORY_EXTRACTION_BACKFILL_DAYS=30

# 完整草稿进入待审后，至少等待这些小时，再由每日任务收录。
# 按业务日计：48 即草稿生成后第 2 天的每日任务里自动入库
MEMORY_AUTO_APPROVE_AFTER_HOURS=48

# 在场卡片距最后报告使用/入库/恢复的归档期限（实际经过天数）。
MEMORY_ARCHIVE_RULE_DAYS=365
MEMORY_ARCHIVE_REFLECTION_DAYS=180
MEMORY_ARCHIVE_KNOWLEDGE_DAYS=180
MEMORY_ARCHIVE_EVENT_DAYS=120
MEMORY_ARCHIVE_EMOTIONAL_DAYS=365
# 回执保护：只统计注入过记忆的已结束轮次，使用和未使用都算回执。
MEMORY_ARCHIVE_RECEIPT_WINDOW_DAYS=14
MEMORY_ARCHIVE_RECEIPT_MIN_SAMPLES=20
MEMORY_ARCHIVE_RECEIPT_MIN_RATE=0.8

# Monthly topic summaries: an explicit model is required; omitted means skipped.
MEMORY_TOPIC_SUMMARY_MODEL=
MEMORY_TOPIC_SUMMARY_BASE_URL=
MEMORY_TOPIC_SUMMARY_API_KEY=
MEMORY_TOPIC_SUMMARY_TIMEOUT_SECONDS=300
# 回执补判（可选）：聊天模型没写使用回执的轮次，每晚由小模型补判用了哪些记忆卡片，
# 计入使用次数与回执率，让归档在 DeepSeek 等很少写回执的模型下也能工作。地址和 key 留空则复用主上游。
# 不配置就不补判，归档在回执不足时保持暂停。
MEMORY_RECEIPT_JUDGE_MODEL=
MEMORY_RECEIPT_JUDGE_BASE_URL=
MEMORY_RECEIPT_JUDGE_API_KEY=
MEMORY_RECEIPT_JUDGE_TIMEOUT_SECONDS=120
# Complete-month windows, including the final month in full.
MEMORY_TOPIC_SUMMARY_MIN_CARDS=5
MEMORY_TOPIC_SUMMARY_MAX_CARDS=30

# Optional asynchronous image captions. Explicit vision model; empty skips.
# Endpoint/key inherit the main upstream only when both are omitted.
MEMORY_IMAGE_DESCRIPTION_MODEL=
MEMORY_IMAGE_DESCRIPTION_BACKUP_MODEL=
MEMORY_IMAGE_DESCRIPTION_BASE_URL=
MEMORY_IMAGE_DESCRIPTION_API_KEY=
# Backup is attempted only for an explicit content-filter/refusal response.
MEMORY_IMAGE_DESCRIPTION_TIMEOUT_SECONDS=30
MEMORY_IMAGE_DESCRIPTION_CONCURRENCY=2
MEMORY_IMAGE_DESCRIPTION_MAX_PENDING=4
MEMORY_IMAGE_DESCRIPTION_MAX_IMAGES=32

# 记忆书签整理独立岗位；地址和 key 均留空时复用主上游，型号须明确填写。
MEMORY_RECENT_NOTES_TIDY_MODEL=
MEMORY_RECENT_NOTES_TIDY_BASE_URL=
MEMORY_RECENT_NOTES_TIDY_API_KEY=
MEMORY_RECENT_NOTES_TIDY_TIMEOUT_SECONDS=300
MEMORY_RECENT_NOTES_SOFT_LIMIT=3500
MEMORY_RECENT_NOTES_TARGET=3000
